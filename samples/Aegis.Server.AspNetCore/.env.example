# Wraith License Server — production secrets template
# COPY THIS FILE TO `.env` ON THE SERVER AND FILL IN STRONG RANDOM VALUES.
# Do NOT commit the real .env to git.

# 64+ random chars, e.g.: openssl rand -base64 64 | tr -d '\n'
JwtSettings__Secret=CHANGE_ME_TO_STRONG_RANDOM_64_OR_MORE_CHARS

# 32+ random chars, e.g.: openssl rand -base64 32 | tr -d '\n'
JwtSettings__Salt=CHANGE_ME_TO_STRONG_RANDOM_SALT

# First-time admin password (login at /api/Authentication/login then create more users)
AdminSeed__Password=CHANGE_ME_AT_FIRST_LOGIN
